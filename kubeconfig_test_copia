apiVersion: v1
kind: Config

clusters:
- name: minikube-proxy
  cluster:
    server: http://192.168.3.1:8001
    insecure-skip-tls-verify: true

users:
- name: proxy-user
  user: {}

contexts:
- name: proxy-context
  context:
    cluster: minikube-proxy
    user: proxy-user
    namespace: formazione-sou

current-context: proxy-context
