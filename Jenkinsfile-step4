pipeline {
    agent any

    environment {
        PATH = "$PATH:/var/jenkins_home/bin"  // Assicurati che kubectl e helm siano qui
        GIT_REPO = 'https://github.com/gianmarcodauria/formazione_sou_k8s.git'
        GIT_BRANCH = 'main'
        HELM_RELEASE = 'formazione-sou-release'
        HELM_NAMESPACE = 'formazione-sou'
        CHART_PATH = './charts/flask-charts'
    }

    stages {
        stage('Verify Tools') {
            steps {
                sh "which kubectl"
                sh "kubectl version --client"
                sh "which helm"
                sh "helm version"
            }
        }

        stage('Checkout Chart') {
            steps {
                git branch: "${GIT_BRANCH}", url: "${GIT_REPO}"
            }
        }

        stage('Prepare Namespace') {
            steps {
                script {
                    sh """
                        if ! kubectl get namespace ${HELM_NAMESPACE} >/dev/null 2>&1; then
                            kubectl create namespace ${HELM_NAMESPACE}
                        fi
                    """
                }
            }
        }

        stage('Helm Lint') {
            steps {
                sh "helm lint ${CHART_PATH}"
            }
        }

        stage('Helm Install or Upgrade') {
            steps {
                script {
                    def exists = sh(
                        script: "helm list -n ${HELM_NAMESPACE} | grep ${HELM_RELEASE} || true",
                        returnStdout: true
                    ).trim()

                    if (exists) {
                        echo "Release ${HELM_RELEASE} già presente. Eseguo upgrade."
