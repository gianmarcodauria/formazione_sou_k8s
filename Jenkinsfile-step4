pipeline {
    agent any
    environment {
        PATH = "/var/jenkins_home/tools:${env.PATH}"
    }
    stages {
        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }

        stage('Check Tools') {
            steps {
                sh '''
                echo "Verifying tools..."
                which kubectl
                kubectl version --client
                which helm
                helm version
                '''
            }
        }

        stage('Prepare Namespace') {
            steps {
                sh '''
                kubectl get namespace formazione-sou || kubectl create namespace formazione-sou
                '''
            }
        }

        stage('Helm Lint') {
            steps {
                sh 'helm lint charts/flask-app'
            }
        }

        stage('Helm Install or Upgrade') {
            steps {
                sh '''
                helm upgrade --install flask-app charts/flask-app \
                  --namespace formazione-sou \
                  --set image.tag=${IMAGE_TAG}
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                kubectl rollout status deployment/flask-app -n formazione-sou
                '''
            }
        }
    }

    post {
        success {
            echo "Pipeline completata con successo!"
        }
        failure {
            echo "Errore nella pipeline."
        }
    }
}

