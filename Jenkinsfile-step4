pipeline {
    agent any

    environment {
        PATH = "/var/jenkins_home/tools:$PATH"
        NAMESPACE = "formazione-sou"
        CHART_PATH = "charts/flask-charts"
        RELEASE_NAME = "flask-app"
    }

    stages {
        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }

        stage('Prepare Namespace') {
            steps {
                script {
                    sh """
                    if ! kubectl get namespace ${NAMESPACE}; then
                        kubectl create namespace ${NAMESPACE}
                    fi
                    """
                }
            }
        }

        stage('Helm Lint') {
            steps {
                sh "helm lint ${CHART_PATH}"
            }
        }

        stage('Helm Install or Upgrade') {
            steps {
                sh """
                helm upgrade --install ${RELEASE_NAME} ${CHART_PATH} \
                    --namespace ${NAMESPACE} \
                    --create-namespace
                """
            }
        }

        stage('Verify Deployment') {
            steps {
                sh "kubectl get all -n ${NAMESPACE}"
            }
        }
    }

    post {
        always {
            echo "Pipeline finished."
        }
        failure {
            echo "Errore nella pipeline."
        }
    }
}

