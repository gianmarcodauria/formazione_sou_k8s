pipeline {
    agent any
    environment {
        PATH = "/var/jenkins_home/tools:${env.PATH}"
    }
    stages {
        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }

        stage('Prepare Namespace') {
            steps {
                script {
                    sh '''
                    kubectl get namespace formazione-sou || \
                    kubectl create namespace formazione-sou
                    '''
                }
            }
        }

        stage('Helm Lint') {
            steps {
                sh 'helm lint ./charts/flask-app'
            }
        }

        stage('Helm Install or Upgrade') {
            steps {
                sh '''
                helm upgrade --install flask-app ./charts/flask-app \
                --namespace formazione-sou
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                kubectl get pods -n formazione-sou
                kubectl get svc -n formazione-sou
                '''
            }
        }
    }
    post {
        success {
            echo 'Pipeline completata con successo!'
        }
        failure {
            echo 'Errore nella pipeline.'
        }
    }
}

