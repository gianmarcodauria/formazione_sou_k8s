pipeline {
    agent any
    environment {
        KUBECONFIG = '/var/jenkins_home/kubeconfig'
    }
    stages {
        stage('Checkout SCM') {
            steps {
                git url: 'https://github.com/gianmarcodauria/formazione_sou_k8s', branch: 'main'
            }
        }
        stage('Prepare Namespace') {
            steps {
                script {
                    sh 'kubectl get namespace formazione-sou --ignore-not-found || kubectl create namespace formazione-sou'
                }
            }
        }
        stage('Helm Lint') {
            steps {
                sh 'helm lint ./helm/flask-app --namespace formazione-sou'
            }
        }
        stage('Helm Install or Upgrade') {
            steps {
                sh '''
                    helm upgrade --install flask-app ./helm/flask-app \
                        --namespace formazione-sou \
                        --set image.tag=latest
                '''
            }
        }
        stage('Verify Deployment') {
            steps {
                sh 'kubectl get pods -n formazione-sou'
            }
        }
    }
    post {
        failure {
            echo 'Errore nella pipeline.'
        }
    }
}

