pipeline {
    agent any

    environment {
        PATH = "/usr/local/bin/tools:${env.PATH}"
        NAMESPACE = "formazione-sou"
        CHART_DIR = "charts/flask-charts"
    }

    stages {
        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }

        stage('Prepare Namespace') {
            steps {
                script {
                    def nsExists = sh(
                        script: "kubectl get namespace ${NAMESPACE} --ignore-not-found",
                        returnStatus: true
                    )
                    if (nsExists != 0) {
                        sh "kubectl create namespace ${NAMESPACE}"
                    }
                }
            }
        }

        stage('Helm Lint') {
            steps {
                sh "helm lint ${CHART_DIR}"
            }
        }

        stage('Helm Install or Upgrade') {
            steps {
                sh """
                    helm upgrade --install flask-app ${CHART_DIR} \
                        --namespace ${NAMESPACE} \
                        --set image.tag=latest
                """
            }
        }

        stage('Verify Deployment') {
            steps {
                sh "kubectl get pods -n ${NAMESPACE}"
            }
        }
    }

    post {
        always {
            echo "Pipeline finished."
        }
        success {
            echo "Deployment succeeded!"
        }
        failure {
            echo "Errore nella pipeline."
        }
    }
}

